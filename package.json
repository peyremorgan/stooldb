{
  "name": "stooldb",
  "version": "0.1.0",
  "description": "Offline-first file-based event store",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "node --test dist/tests/**/*.test.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "typescript": "^5.8.3"
  }
}
