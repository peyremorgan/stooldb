{
  "$id": "stooldb/snapshot/v1",
  "type": "object",
  "required": [
    "version",
    "streamId",
    "snapshotSequence",
    "createdAt",
    "createdBy",
    "eventRange",
    "checksum",
    "state"
  ],
  "properties": {
    "version": { "const": "1" },
    "streamId": { "type": "string", "minLength": 1 },
    "snapshotSequence": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "createdBy": { "type": "string", "minLength": 1 },
    "eventRange": {
      "type": "object",
      "required": ["fromSequence", "toSequence"],
      "properties": {
        "fromSequence": { "type": "integer", "minimum": 1 },
        "toSequence": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "checksum": { "type": "string", "minLength": 1 },
    "state": {}
  },
  "additionalProperties": false
}
